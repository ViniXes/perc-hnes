# Variables de entorno requeridas. Copia este archivo a .env.local y completa los
# valores. En produccion, definelas en Vercel (Project Settings -> Environment Variables).
# NO subas .env.local al repositorio (esta en .gitignore).

# --- Firebase (config publica del cliente) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Opcional: base Firestore con nombre (por defecto "(default)").
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=

# --- Credenciales de acceso ---
# OJO: al ser app cliente, estas quedan visibles en el bundle del navegador.
# La proteccion real es ROTAR estas claves y mantener el repositorio PRIVADO.
NEXT_PUBLIC_ADMIN_USERNAME=
NEXT_PUBLIC_ADMIN_PASSWORD=
NEXT_PUBLIC_ADMIN_EMAIL=
# Clave temporal con la que se crean los usuarios de servicio y supervisores.
NEXT_PUBLIC_DEFAULT_TEMP_PASSWORD=

# --- Asistente virtual (respaldo con IA, opcional) ---
# Clave de Google Gemini para el respaldo inteligente del asistente. Se usa SOLO
# del lado del servidor (no lleva NEXT_PUBLIC_, no se expone al navegador).
# Se saca gratis en https://aistudio.google.com/apikey
# Si se deja vacia, el asistente sigue funcionando con la capa de palabras clave.
GEMINI_API_KEY=

# --- Aviso por correo al aprobar/rechazar un registro (opcional) ---
# Cuando el admin aprueba una solicitud, PULSO le manda a la persona su usuario y
# la clave generica; si la rechaza, le manda un aviso. Solo del lado del servidor.
# Se usa el proveedor cuya clave este cargada (basta con UNA de las dos):
#   Brevo  -> https://app.brevo.com  (300 correos/dia gratis)
#   Resend -> https://resend.com
BREVO_API_KEY=
RESEND_API_KEY=
# Correo remitente YA VERIFICADO en el proveedor y nombre visible del remitente.
MAIL_FROM=
MAIL_FROM_NAME=PULSO · Hospital Nacional El Salvador
